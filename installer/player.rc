/* 窗口宿主的资源:图标 + 清单 + 版本信息 */
#include <windows.h>

#define IDI_APPICON 101
#define IDR_WVLOADER 110

IDI_APPICON ICON "icon.ico"

1 24 "app.manifest"

/* 内嵌 WebView2Loader.dll:桌面只放一个 exe 也能运行(启动时解压到临时目录) */
IDR_WVLOADER RCDATA "WebView2Loader.dll"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Lyra"
            VALUE "FileDescription",  "Lyra"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "LingYueReader"
            VALUE "OriginalFilename", "Lyra.exe"
            VALUE "ProductName",      "Lyra"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
