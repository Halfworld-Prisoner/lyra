# 统一换行:仓库里按 LF 存,检出到 Windows 时源码用 CRLF(PowerShell 脚本与 C 源码更省心)
* text=auto

*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.c     text eol=crlf
*.cpp   text eol=crlf
*.h     text eol=crlf
*.rc    text eol=crlf
*.ps1   text eol=crlf
*.cs    text eol=crlf

# 二进制
*.png   binary
*.ico   binary
*.dll   binary
*.zip   binary
*.onnx  binary
